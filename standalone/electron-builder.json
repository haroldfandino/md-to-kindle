{
  "appId": "com.haroldfandino.md-to-kindle",
  "productName": "md-to-kindle",
  "directories": { "app": "standalone-dist", "output": "dist/standalone" },
  "files": ["**/*"],
  "asar": true,
  "artifactName": "md-to-kindle-${version}-${os}-${arch}.${ext}",
  "win": { "target": ["zip"], "signAndEditExecutable": false },
  "mac": {
    "target": ["zip"],
    "category": "public.app-category.productivity",
    "identity": null
  }
}
